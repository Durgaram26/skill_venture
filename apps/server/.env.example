NODE_ENV=production
PORT=4000

# MongoDB Atlas connection string. Set this only on the backend host.
MONGODB_URI=mongodb+srv://<atlas-user>:<atlas-password>@cluster0.lzloqme.mongodb.net/skillventures?retryWrites=true&w=majority

# Redis is required by the server token store and cache.
REDIS_URL=redis://localhost:6379

# Use long random values of at least 32 characters.
JWT_ACCESS_SECRET=replace-with-a-random-access-secret-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-a-random-refresh-secret-at-least-32-characters
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_COST=12

# Frontend origin, including protocol and no trailing slash.
CLIENT_URL=https://skillventures-web.onrender.com
COOKIE_SECURE=true

# Optional integrations.
GOOGLE_CLIENT_ID=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Optional seed credentials (defaults used if unset). preDeployCommand runs seed on each deploy.
SUPER_ADMIN_EMAIL=superadmin@skillventures.local
SUPER_ADMIN_PASSWORD=SuperAdminPass123
ADMIN_EMAIL=admin@skillventures.local
ADMIN_PASSWORD=AdminPass123
STUDENT_EMAIL=demo.student@skillventures.local
STUDENT_PASSWORD=DemoPass123
