{
  "name": "@skillventures/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src tests --ext .ts",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest --runInBand --forceExit",
    "seed:admin": "tsx src/scripts/seed-admin.ts",
    "seed:super-admin": "tsx src/scripts/seed-super-admin.ts",
    "seed:student": "tsx src/scripts/seed-student.ts",
    "fetch:mock-images": "tsx src/scripts/fetch-mock-images.ts",
    "seed:mock": "tsx src/scripts/seed-mock-listings.ts",
    "seed": "node dist/scripts/seed-super-admin.js && node dist/scripts/seed-admin.js && node dist/scripts/seed-student.js && node dist/scripts/seed-mock-listings.js"
  },
  "dependencies": {
    "@skillventures/shared-types": "*",
    "bcrypt": "^5.1.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.2",
    "rate-limit-redis": "^4.2.0",
    "serverless-http": "^4.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.2",
    "@types/supertest": "^6.0.2",
    "jest": "^29.7.0",
    "mongodb-memory-server": "^10.1.2",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
