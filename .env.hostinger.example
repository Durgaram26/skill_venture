# Copy to .env on the VPS: cp .env.hostinger.example .env
# This stack uses its own MongoDB container — it does NOT connect to other project databases.

NODE_ENV=production
PORT=4000

# Overridden by docker-compose.hostinger.yml (internal Docker network).
MONGODB_URI=mongodb://mongo:27017/skillventures

# Redis not used — omit REDIS_URL; server uses in-memory cache and token store.

# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=replace-with-a-random-access-secret-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-a-random-refresh-secret-at-least-32-characters
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_COST=12

# Public URL users open in the browser (no trailing slash).
# Example: http://YOUR_SERVER_IP:8094 or https://skillventures.yourdomain.com
CLIENT_URL=http://YOUR_SERVER_IP:8094
COOKIE_SECURE=false

# Optional
GOOGLE_CLIENT_ID=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
